# Environment Variables Template
# Copy this file to .env and adjust as needed.
# NOTE: No API keys are required for default public market data or paper simulation.

# REST Service Security
# Token required for all POST endpoints (e.g. /trade/step)
API_TOKEN="change_me_to_a_secure_random_string"

# Live Trading Safety Interlocks
# To execute real trades, BOTH config `live_execution_enabled: true`
# AND CONFIRM_LIVE="YES" must be set. Otherwise system operates in PAPER mode.
CONFIRM_LIVE="NO"

# Binance Sandbox vs Production
# Set to "true" to use Binance Spot/Perp Testnet sandbox
BINANCE_USE_TESTNET="true"

# Binance API Credentials
# CRITICAL SECURITY RULE:
# NEVER enable "Withdrawal" permissions on this API key!
# The bot strictly requires Read (and optional Trade for live execution) permissions only.
# The bot will REFUSE to start if withdrawal permissions are detected.
BINANCE_API_KEY=""
BINANCE_API_SECRET=""

# Network & Service Binding
# Must remain 127.0.0.1 for local security
SERVICE_HOST="127.0.0.1"
SERVICE_PORT=8000
ENVIRONMENT="development"
LOG_LEVEL="INFO"
